{
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/coming-soon", "destination": "/coming-soon.html" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
